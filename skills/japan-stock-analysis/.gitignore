# Skill secret config (must never be committed)
secret.json

# Local cache (regenerable from EDINET / yfinance)
cache/

# Python virtualenv (used for local Skill development)
env/
.venv/

# Python build / cache artifacts
__pycache__/
*.pyc
*.pyo

# Test cache
.pytest_cache/

# Defense in depth: BUG-001 や手動操作で誤って Skill 配下に成果物が出ても commit されないように
report_*.html
data_*.json
mapping_escalation_*.json
mapping_*.json
